import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

df= pd.read_csv("/content/RIL_Closing.csv")
df

df["Date"] = pd.to_datetime(df["Date"], dayfirst=True)
df = df.sort_values("Date")


short_window = 20
long_window =  50

df["SMA_20"]  = df['Close'].rolling(window= short_window).mean()
df["SMA_50"] = df["Close"].rolling(window= long_window).mean()


###  Tradig Signal

df["Signal"] = np.where(df["SMA_20"] > df["SMA_50"],1,0)
df["Position"] = df["Signal"].diff()


### Buy and Sell signal

signals = df[df["Position"].isin([1, -1])].copy()
signals["Actions"]  = signals["Position"].map({
    1: "buy",
    -1: "Sell"
})

print("SMA crossover Buy and Sell signals")
print(signals[["Date", "Close", "SMA_20", "SMA_50", "Actions"]])



plt.figure(figsize=(14, 7))

plt.plot(
    df['Date'],
    df['Close'],
    label='Close Price'
)


plt.plot(
    df['Date'],
    df['SMA_20'],
    label='20-Day SMA'
)


plt.plot(
    df['Date'],
    df['SMA_50'],
    label='50-Day SMA'
)


plt.scatter(
    df[df["Position"] == 1]["Date"],
    df[df["Position"] == 1]["Close"],
    marker='^',
    s=120,
    label="Buy Signal"
)

plt.scatter(
    df[df["Position"] == -1]["Date"],
    df[df["Position"] == -1]["Close"],
    marker='v',
    s=120,
    label="Sell Signal"
)

plt.title("RIL SMA Crossover Strategy")
plt.xlabel("Date")
plt.ylabel("Close Price")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()
